# Copy this file to .env (do not commit it) and load the values in your
# deployment environment or secret manager.
DJANGO_SECRET_KEY=replace-with-a-50-character-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_SECURE_COOKIES=True

# Production database. SQLite is used only when these are absent.
POSTGRES_DB=physiotrac360
POSTGRES_USER=physiotrac360_app
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Keep disabled until a HIPAA-eligible AI provider, BAA, data-use review,
# retention controls, and tenant isolation have all been configured.
AI_DRAFTING_ENABLED=False

# Public URL of the deployed React frontend. Used to build links sent outside
# the app (e.g. client-admin invitation emails). Must match the real domain
# in production, or invitation links will point at a dev server no one else
# can reach.
FRONTEND_BASE_URL=https://app.example.com

# Outbound email. Leave EMAIL_BACKEND unset in development to print emails to
# the server console instead of sending them. For production, point these at
# a provider covered by your organization's BAA (SES, Postmark, an SMTP relay,
# etc.) — these emails never carry PHI, only account setup links.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@app.example.com
