# Copy to deploy/env.production on the instance (never commit the real file)
# and fill in real values. This is a systemd EnvironmentFile: plain KEY=VALUE
# lines, no quotes, no "export".
#
# POSTGRES_* is intentionally omitted here — leaving it unset makes Django
# fall back to SQLite (config/settings.py), which is fine for a throwaway
# test instance. Add POSTGRES_* (see .env.example) once you move to RDS.

DJANGO_SECRET_KEY=replace-with-a-50-character-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=replace-with-instance-public-ip-or-domain
DJANGO_SECURE_COOKIES=False
FRONTEND_BASE_URL=http://replace-with-instance-public-ip-or-domain
AI_DRAFTING_ENABLED=False
